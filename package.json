{
  "name": "minista-project",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "minista",
    "build": "minista build",
    "preview": "minista preview",
    "lint:js": "eslint src --ext .js,.jsx",
    "lint:js:fix": "eslint src --ext .js,.jsx --fix",
    "lint:css": "stylelint \"**/*.{css,scss,pcss}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss,pcss}\" --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "run-s lint:js lint:css format",
    "lint:fix": "run-s lint:js:fix lint:css:fix format:fix",
    "svg:clean": "svgo -f src/assets/icons"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "@babel/plugin-syntax-jsx": "7.28.6",
    "@eslint/js": "9.30.1",
    "eslint": "9.30.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.6.0",
    "minista": "4.0.1",
    "npm-run-all": "4.1.5",
    "postcss-preset-env": "11.2.1",
    "postcss-pxtorem": "6.1.0",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.99.0",
    "stylelint": "17.11.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "svgo": "4.0.1",
    "vite": "8.0.3"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead"
  ]
}
